# Spotify API Credentials
# Create an app at https://developer.spotify.com/dashboard
# Set Redirect URI to http://127.0.0.1:8080 in Spotify App settings
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8080

# YouTube Music Credentials
# File where your YTMusic token or session is saved (e.g. oauth.json or browser.json)
YTM_AUTH_FILE=oauth.json

# Optional: If using Google Cloud OAuth with TV/Device Flow:
YTM_CLIENT_ID=
YTM_CLIENT_SECRET=
